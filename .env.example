# Browser: public Supabase project URL and anon/publishable key only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server: same Supabase project. Never use a service_role key in VITE_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# n8n: configure Header Auth on the extraction webhook with the same secret.
N8N_EXTRACT_WEBHOOK=https://your-n8n.example/webhook/tct-extract
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret
PORT=3002

# Alternative to n8n: server-side OpenRouter extraction.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
